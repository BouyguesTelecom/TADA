meta {
  name: PATCH FILE with FILE
  type: http
  seq: 6
}

patch {
  url: {{URL_API}}{{URL_API_PREFIX}}/file/{{IMAGE_ID}}
  body: multipartForm
  auth: bearer
}

headers {
  Authorization: Bearer token
}

auth:bearer {
  token: {{AUTH_TOKEN}}
}

body:multipart-form {
  file: @file(/Users/myvart/Downloads/download.webp)
  namespace: DEV
  toWebp: true
}
